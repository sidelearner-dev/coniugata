# Copy to .env and fill in what you have. Missing keys simply skip keyed modules.
CONIUGATA_HIBP_KEY=
CONIUGATA_SHODAN_KEY=
CONIUGATA_URLSCAN_KEY=
CONIUGATA_VT_KEY=

CONIUGATA_REQUEST_TIMEOUT=20
CONIUGATA_CONCURRENCY=10
CONIUGATA_CACHE_TTL=3600
CONIUGATA_MAX_RESPONSE_BYTES=16777216
CONIUGATA_MAX_ENTITIES=50000

# Optional: override the default anonymous User-Agent
# CONIUGATA_USER_AGENT=

# Anonymous identity mode: install (persist one token), run (fresh token per
# run), or none (send no fingerprint). Default: install.
CONIUGATA_IDENTITY_MODE=install
# Optional: override the per-install token (auto-generated if blank)
CONIUGATA_INSTANCE_TOKEN=
# Optional: local scan-history database (default ~/.local/share/coniugata/coniugata.db)
CONIUGATA_DB_PATH=

# theHarvester wrapper (no key needed; uses the local binary)
CONIUGATA_THEHARVESTER_BIN=theHarvester
CONIUGATA_THEHARVESTER_SOURCES=crtsh,otx,hackertarget,rapiddns
CONIUGATA_THEHARVESTER_LIMIT=500
CONIUGATA_THEHARVESTER_TIMEOUT=180
