# Copy to .env and fill in what you have. Missing keys simply skip keyed modules.
CONIUGATA_HIBP_KEY=
CONIUGATA_SHODAN_KEY=
CONIUGATA_URLSCAN_KEY=
CONIUGATA_VT_KEY=

CONIUGATA_REQUEST_TIMEOUT=20
CONIUGATA_CONCURRENCY=10
CONIUGATA_CACHE_TTL=3600
CONIUGATA_USER_AGENT=coniugata/0.1 (authorized security research; you@example.com)
